        </mxCell>
        <mxCell id="stage_aggregate" value="E. Aggregate topic → frame&#xa;Topic-first prevents metric-count weighting&#xa;Livability/Opportunity signed • Character magnitude-only&#xa;Retain coverage + directional agreement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" parent="engine_box" vertex="1">
